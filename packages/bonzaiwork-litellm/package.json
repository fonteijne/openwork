{
  "name": "@bonzaiwork/litellm",
  "private": true,
  "type": "module",
  "description": "BonzaiWork LiteLLM integration: virtual-key storage, the loopback proxy route and the openwork-server hooks that install it.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server-hooks": {
      "types": "./src/server-hooks.ts",
      "default": "./dist/server-hooks.js"
    },
    "./keys": {
      "types": "./src/keys.ts",
      "default": "./src/keys.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build src/server-hooks.ts --outfile dist/server-hooks.js --target node --format esm",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "e2e": "bun e2e/engine.e2e.ts"
  },
  "dependencies": {
    "@bonzaiwork/policy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.13",
    "typescript": "^5.6.3"
  }
}
